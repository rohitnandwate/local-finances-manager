# Load order: `.env.local` is loaded first, then `.env` (see src/config.ts).
# Copy this file to `.env.local` and/or `.env` and replace placeholder values.

# --- HTTP server ---
HOST=127.0.0.1
PORT=3000

# Optional: expose `/api/files/*` browser endpoints for local debugging only.
# DEBUG_FILES=true

# --- Plaid ---
# First-run path is Sandbox (test institutions). New Plaid accounts usually have Sandbox keys immediately.
# Live banks: PLAID_ENV=production and PROD_PLAID_SECRET after Dashboard Production approval.
PLAID_ENV=sandbox
PLAID_CLIENT_ID=your_plaid_client_id

# Secret for the active PLAID_ENV (see src/config.ts):
# - sandbox → SANDBOX_PLAID_SECRET or PLAID_SECRET
# - production → PROD_PLAID_SECRET or PLAID_SECRET
SANDBOX_PLAID_SECRET=your_sandbox_plaid_secret
# PROD_PLAID_SECRET=your_production_plaid_secret
# DEV_PLAID_SECRET=your_development_plaid_secret
# PLAID_SECRET=your_fallback_secret_if_you_use_one_variable

PLAID_COUNTRY_CODES=US
PLAID_PRODUCTS=transactions

# Days of transaction history requested when linking (max 730).
PLAID_DAYS_REQUESTED=730

# Optional. Required for some OAuth institutions. Must match a Dashboard allowed redirect URI.
# Example: PLAID_REDIRECT_URI=http://127.0.0.1:3000/

# --- LLM (optional): category review, briefings, chat ---
# Provider: openai | anthropic | google
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o

# Only the active provider needs a key:
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
GOOGLE_GENERATIVE_AI_API_KEY=your_google_api_key

# --- Optional: home LAN access ---
# For HOST=0.0.0.0, set BOTH (Wi‑Fi gating on — default on macOS):
#   LAN_ACCESS_CODE=your_shared_secret
#   LAN_ALLOWED_WIFI_SSIDS=MyHomeNetwork,OtherAllowedSSID
# LAN_AUTH_SECRET=           # optional; derived from access code if unset
# LAN_WIFI_CHECK_INTERVAL_SEC=45
# On Linux / CI / debugging (no SSID check): BUDGET_TRACKER_DISABLE_WIFI_GATING=1

# --- macOS: Plaid tokens in Keychain ---
# Access tokens live in macOS Keychain (not in plaid-session.json). Each `.data`
# directory normally gets its own Keychain service name via `.data/.keychain-namespace`.
# Optional overrides:
#   BUDGET_TRACKER_KEYCHAIN_SUFFIX=default   → legacy shared service `budget-expense-tracker`
#   BUDGET_TRACKER_KEYCHAIN_SUFFIX=myclone   → `budget-expense-tracker-myclone`
# Concurrent processes sharing one service serialize Keychain access (darwin).
